{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iphone-duo-pickup-watch",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name":"MONITOR","class_name":"PickupMonitor"}]},
  "migrations": [{"tag":"v1","new_sqlite_classes":["PickupMonitor"]}],
  "observability": {"enabled": false}
}
